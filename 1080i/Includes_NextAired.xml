                <onup condition="$EXP[Exp_HomeMenu_IsTopBar]">303</onup>
                <onfocus condition="Skin.String(Hub.$PARAM[window_id].WidgetMode,Wall)">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
