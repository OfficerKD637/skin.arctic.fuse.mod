                <ondown>SetFocus($INFO[Container($PARAM[id]).ListItem.Property(listid)],0,absolute)</ondown>
                <onleft condition="$EXP[Exp_HomeMenu_IsStatic]">303</onleft>
                <onback condition="$EXP[Exp_HomeMenu_IsStatic] + !Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)">SetFocus($PARAM[id],0,absolute)</onback>
