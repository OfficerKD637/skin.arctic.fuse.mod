    <!-- Banner Wall -->
    <include name="View_580_Banner_Wall">
        <include content="View_Wall_Include">
            <param name="id">580</param>
            <param name="include">List_MiniBanner_Row</param>
            <param name="bottom_padding">0</param>
            <param name="viewtype_label">$LOCALIZE[31596]</param>
            <param name="visible">$EXP[Exp_View_580]</param>
        </include>
    </include>

    <!-- Row Template View -->
    <include name="View_Wall_Include">
        <param name="right_padding">180</param>
        <param name="top">306</param>
        <param name="top_horz">250</param>
        <param name="offset_x">view_offx</param>
        <param name="offset_y">20</param>
        <param name="bottom_padding">-40</param>
        <param name="wall_textlabels">false</param>
        <definition>
            <control type="group">
                <visible>Control.IsVisible($PARAM[id])</visible>
                <control type="group">                    

                    <visible>!$EXP[Exp_InfoDialogs]</visible>                

                    <include content="Animation_Zoom_In">
                        <param name="type">Visible</param>
                        <param name="delay">200</param>
                    </include>
                    <include content="Animation_Zoom_Out">
                        <param name="type">Hidden</param>
                        <param name="delay">200</param>
                    </include>

                    <include content="$PARAM[include]" condition="$EXP[Exp_View_WallVert]">
                        <param name="id">$PARAM[id]</param>
                        <param name="control">panel</param>
                        <param name="orientation">vertical</param>
                        <param name="offset_x">$PARAM[offset_x]</param>
                        <param name="offset_y">$PARAM[offset_y]</param>
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="item_w">$PARAM[item_w]</param>
                        <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
                        <param name="itemlayout_w">$PARAM[itemlayout_w]</param>
                        <param name="use_movement">$PARAM[use_movement]</param>
                        <param name="detailed">$PARAM[detailed]</param>
                        <param name="wall_textlabels">$PARAM[wall_textlabels]</param>
                        <preloaditems>0</preloaditems>
                        <include content="Object_Top" condition="!Skin.HasSetting(View.SwitchVerticalWallSize)">
                            <param name="top">$PARAM[top]</param>
                        </include>
                        <include content="Object_Top" condition="Skin.HasSetting(View.SwitchVerticalWallSize)">
                            <param name="top">40</param>
                        </include>
                        <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                            <param name="right">$PARAM[right_padding]</param>
                        </include>
                        <bottom>$PARAM[bottom_padding]</bottom>
                        <onleft condition="Skin.String(Home.SideMenuCollapse,Never)">SetProperty(List.ViewContainer,50)</onleft>
                        <onleft condition="Skin.String(Home.SideMenuCollapse,Never)">SetFocus(303,1,absolute)</onleft>
                        <onright>611</onright>
                        <include>Action_View_SlideOver_OnFocus</include>


                        <include content="Action_View_Movement_OnBack">
                            <param name="id">$PARAM[id]</param>
                            <param name="onback">True</param>
                        </include>

                        <pagecontrol>66</pagecontrol>
                        <visible>$PARAM[visible]</visible>
                        <viewtype label="$PARAM[viewtype_label]">wrap</viewtype>
                        <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
                        <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                    </include>

                    <include content="$PARAM[include]" condition="!$EXP[Exp_View_WallVert]">
                        <param name="id">$PARAM[id]</param>
                        <param name="control">panel</param>
                        <param name="offset_x">$PARAM[offset_x]</param>
                        <param name="item_h">$PARAM[item_h]</param>
                        <param name="item_w">$PARAM[item_w]</param>
                        <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
                        <param name="itemlayout_w">$PARAM[itemlayout_w]</param>
                        <param name="use_movement">$PARAM[use_movement]</param>
                        <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                            <param name="right">$PARAM[right_padding]</param>
                        </include>
                        <top>$PARAM[top_horz]</top>
                        <bottom>$PARAM[bottom_padding]</bottom>
                        <include>Action_View_SlideOver_OnFocus</include>
                        <include content="Action_View_Movement_OnUp">
                            <param name="id">$PARAM[id]</param>
                        </include>
                        <include content="Action_View_Movement_OnLeftRight">
                            <param name="id">$PARAM[id]</param>
                            <param name="onback">[Integer.IsEqual(Container($PARAM[id]).CurrentItem,1)]</param>
                        </include>
                        <include content="Action_View_Movement_OnDown">
                            <param name="id">$PARAM[id]</param>
                        </include>
                        <pagecontrol>60</pagecontrol>
                        <visible>$PARAM[visible]</visible>
                        <viewtype label="$PARAM[viewtype_label]">wrap</viewtype>
                        <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
                        <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                    </include>
                    <control type="group">
                        <control type="image">
                            <bottom>0</bottom>
                            <height>480</height>
                            <texture colordiffuse="main_bg_90">common/gradient-v.png</texture>
                            <animation effect="fade" start="0" end="100" time="300" tween="sine" easing="in" condition="[$EXP[Exp_View_SortModeButtons_HasFocus] | $EXP[Exp_View_ScrollFilter_HasFocus] | $EXP[Exp_View_AlphabetFilter_HasFocus] | Window.IsVisible(1171)]" reversible="false">Conditional</animation>
                            <animation effect="fade" start="100" end="0" time="300" tween="sine" easing="in" condition="![$EXP[Exp_View_SortModeButtons_HasFocus] | $EXP[Exp_View_ScrollFilter_HasFocus] | $EXP[Exp_View_AlphabetFilter_HasFocus] | Window.IsVisible(1171)]" reversible="false">Conditional</animation>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>
</includes>
