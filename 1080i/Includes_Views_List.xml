    <include name="View_MediaList_BigPoster">
        <control type="group">
            <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                <param name="right">80</param>
            </include>
            <right>-40</right>
            <control type="group">
                <visible>!$EXP[Exp_InfoDialogs]</visible>
                <include content="Widget_Standard_Animation">
                    <param name="visible_delay">120</param>
                    <param name="hidden_delay">240</param>
                    <param name="slide_x">240</param>
                </include>
                <control type="group">
                    <include content="Object_Bottom" condition="![!Skin.HasSetting(Furniture.EnableLeftHeader) + !Skin.HasSetting(Furniture.EnableClock) + !String.IsEmpty(Skin.String(Furniture.EnableClock.TopLeft))]">
                        <param name="bottom">20</param>
                    </include>
                    <bottom>0</bottom>
                    <right>40</right>
                    <include content="Object_Height" condition="![!Skin.HasSetting(Furniture.EnableLeftHeader) + !Skin.HasSetting(Furniture.EnableClock) + !String.IsEmpty(Skin.String(Furniture.EnableClock.TopLeft))]">
                        <param name="height">820</param>
                    </include>
                    <include content="Object_Width" condition="![!Skin.HasSetting(Furniture.EnableLeftHeader) + !Skin.HasSetting(Furniture.EnableClock) + !String.IsEmpty(Skin.String(Furniture.EnableClock.TopLeft))]">
                        <param name="width">560</param>
                    </include>
                    <width>infodialog_bigposter_w</width>
                    <height>infodialog_bigposter_h</height>
                    <visible>![String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster))]</visible>
                    <include content="Object_BigPoster">
                        <param name="icon">$VAR[Image_Poster]</param>
                        <param name="diffuse">diffuse/poster_w460_h680.png</param>
                        <param name="diffuse_special">diffuse/poster_w560_h820.png</param>
                        <param name="include_diffuse_special">![!Skin.HasSetting(Furniture.EnableLeftHeader) + !Skin.HasSetting(Furniture.EnableClock) + !String.IsEmpty(Skin.String(Furniture.EnableClock.TopLeft))]</param>
                    </include>
                </control>
                <control type="group">
                    <right>0</right>
                    <height>768</height>
                    <width>520</width>
                    <bottom>0</bottom>
                    <visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster))</visible>
                    <control type="image">
                        <width>520</width>
                        <height>520</height>
                        <centerbottom>520</centerbottom>
                        <texture background="true">$VAR[Image_DiscArt]</texture>
                        <bordersize>20</bordersize>
                        <animation effect="rotate" condition="Player.Playing" start="0" end="-360" loop="true" time="30000" center="auto" reversible="false">Conditional</animation>
                        <visible>![String.IsEmpty(ListItem.Art(discart)) + String.IsEmpty(ListItem.Art(album.discart))]</visible>
                    </control>
                    <include content="Object_BigPoster">
                        <param name="icon">$VAR[Image_Poster]</param>
                        <param name="diffuse">diffuse/square_w600_h600.png</param>
                        <width>520</width>
                        <height>520</height>
                        <right>40</right>
                        <bottom>0</bottom>
                    </include>
                </control>
            </control>
        </control>
    </include>
    
