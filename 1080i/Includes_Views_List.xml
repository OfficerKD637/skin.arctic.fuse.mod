    <include name="View_MediaList_Include">
        <param name="overlay">false</param>
        <param name="scrollbar_id">66</param>
        <param name="alphabet_id">616</param>
        <param name="control">fixedlist</param>
        <param name="itemlayout_include">Layout_MediaList</param>
        <param name="left">-20</param>
        <param name="bottom">20</param>
        <param name="top">402</param>
        <param name="focusposition">1</param>
        <param name="movement">2</param>
        <definition>

            <control type="group">
                <visible>Control.IsVisible($PARAM[id])</visible>
                <include>Dimension_Info</include>

                <nested />

                <control type="group">
                    <left>$PARAM[left]</left>
                    <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                        <param name="right">$PARAM[right_downsize]</param>
                    </include>
                    <right>$PARAM[right]</right>
                    <bottom>$PARAM[bottom]</bottom>
                    <top>$PARAM[top]</top>

                    <visible>!$EXP[Exp_InfoDialogs]</visible>

                    <include content="Animation_Fade_In">
                        <param name="type">Visible</param>
                        <param name="delay">40</param>
                        <param name="time">300</param>
                    </include>
                    <include content="Animation_Fade_Out">
                        <param name="type">Hidden</param>
                        <param name="delay">320</param>
                        <param name="time">200</param>
                    </include>

                    <include content="List_DialogSelect">
                        <param name="id">$PARAM[id]</param>
                        <param name="textcolor">main_fg</param>
                        <param name="control">$PARAM[control]</param>
                        <param name="itemlayout_include">$PARAM[itemlayout_include]</param>
                        <param name="diffuse">$PARAM[diffuse]</param>
                        <param name="item_height">$PARAM[item_height]</param>
                        <param name="variation">$PARAM[variation]</param>
                        <param name="misc">$PARAM[misc]</param>
                        
                        <right>30</right>

                        <onleft>SetProperty(List.ViewContainer,50)</onleft>
                        <onleft>SetFocus(303)</onleft>

                        <onright condition="$EXP[Exp_IsAlphabetStrip] + !Integer.IsEqual(Container.NumPages,1)">SetFocus($PARAM[alphabet_id],$VAR[Action_Letter_Position],absolute)</onright>
                        <onright condition="![$EXP[Exp_IsAlphabetStrip] + !Integer.IsEqual(Container.NumPages,1)]">611</onright>
                        <onright condition="Skin.String(Navigation.Global.OnDown,Explore)">SetProperty(Item_Widget_Style,$VAR[Action_View_Explore_Viewtype],1181)</onright>

                        <include content="Action_View_Movement_OnBack">
                            <param name="id">50</param>
                            <param name="onback">True</param>
                            <param name="onleft">50</param>
                        </include>

                        <focusposition>$PARAM[focusposition]</focusposition>
                        <movement>$PARAM[movement]</movement>
                        <top>15</top>
                        <pagecontrol>$PARAM[scrollbar_id]</pagecontrol>
                        <visible>$PARAM[visible]</visible>
                        <viewtype label="$PARAM[viewtype_label]">list</viewtype>
                        <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
                        <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
                        <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                        <include>Action_View_SlideOver_OnFocus</include>
                    </include>                
                </control>
            </control>
        </definition>
    </include>
</includes>