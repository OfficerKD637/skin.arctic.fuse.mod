<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for SkinVariables run_skinsettings. The script fills grouplists 3 and 5 from shortcuts/skinvariables-skinsettings.json
     using the template controls below, configures the search box in place, sets the description in textbox 6, and removes the
     template controls from the generated window. -->
<window>
    <include content="Action_SettingsCategories_Onload">
        <param name="defaultcontrol">3</param>
    </include>

    <!-- Set Some Profile Settings -->
    <onunload>runscript($VAR[Action_Var_BuildTextures])</onunload>
    <onload condition="String.IsEmpty(Skin.String(Skin.SettingsLevel))">Skin.SetString(Skin.SettingsLevel,$NUMBER[1])</onload>
    
    <onunload>$VAR[Action_RatingsMonitor]</onunload>

    <controls>

        <include>Background</include>

        <include content="Settings_Dialog">
            <include content="Settings_Main_Group">
                <param name="label">$LOCALIZE[166] $LOCALIZE[5]</param>
                <include content="Settings_Left_Group">
                    <include content="Settings_Left_Content">
                        <control type="grouplist" id="3">
                            <orientation>vertical</orientation>
                            <onup>3</onup>
                            <ondown>3</ondown>
                            <onright condition="![String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks) + String.IsEmpty(Window.Property(SkinVariables.SkinSettings.Search.Query))]">5</onright>
                            <onright condition="String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks) + String.IsEmpty(Window.Property(SkinVariables.SkinSettings.Search.Query))">12</onright>
                            <right>40</right>
                        </control>
                        <control type="group">
                            <top>640</top>
                            <height>80</height>
                            <width>80</width>
                            <right>50</right>
                            <control type="image">
                                <texture colordiffuse="main_fg_70">$VAR[Image_SkinSettings_Level]</texture>
                                <bordersize>10</bordersize>
                                <visible>!String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)</visible>
                            </control>
                            <control type="image">
                                <texture colordiffuse="$VAR[ColorSelected]">$VAR[Image_SkinSettings_Level]</texture>
                                <bordersize>10</bordersize>
                                <visible>String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)</visible>
                            </control>
                        </control>
                    </include>
                </include>
                <include content="Settings_Right_Group">
                    <param name="header">$VAR[Label_SkinSettings_Category]</param>
                    <param name="visible_line">![String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks) + String.IsEmpty(Window.Property(SkinVariables.SkinSettings.Search.Query))]</param>

                    <control type="group">
                        <visible>String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks) + String.IsEmpty(Window.Property(SkinVariables.SkinSettings.Search.Query))</visible>
                        <include content="Dialog_ItemLine">
                            <param name="label">$LOCALIZE[31345]</param>
                            <param name="colordiffuse">main_fg</param>
                        </include>
                    </control>

                    <include content="Settings_Right_Scrollbar">
                        <onleft>5</onleft>
                    </include>

                    <!-- The first and last settings move to the search box -->
                    <include content="SkinSettings_Right_Grouplist">
                        <param name="id">5</param>
                        <onleft>3</onleft>
                        <onup>20</onup>
                        <ondown>20</ondown>
                    </include>

                    <!-- Global search box and tags button. The script keeps them in place, opens the tags to filter by from the tags button,
                         and sets the selected tag and the first and last settings in view as window properties.
                         The group remembers which of them was last focused so the settings can move back to it -->
                    <control type="group" id="20">
                        <defaultcontrol>12</defaultcontrol>
                        <include content="Settings_SearchBox">
                            <param name="buttonid">17</param>
                            <param name="icon">special://skin/extras/icons/tags.png</param>
                            <param name="right">600</param>
                            <param name="width">280</param>
                            <include content="Settings_SearchBox_Button">
                                <param name="id">17</param>
                                <description>Tags Button</description>
                                <label>$VAR[Label_Settings_SearchTag]</label>
                                <!-- The box width less the icon offset and a smaller right padding than textoffsetx gives -->
                                <textwidth>170</textwidth>
                                <onleft condition="!String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)">3</onleft>
                                <onleft condition="String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)">-192</onleft>
                                <onright>12</onright>
                            </include>
                        </include>
                        <include content="Settings_SearchBox">
                            <param name="buttonid">12</param>
                            <param name="icon">special://skin/extras/icons/search.png</param>
                            <include content="Settings_SearchBox_Button">
                                <param name="id">12</param>
                                <param name="control">edit</param>
                                <description>Search Edit</description>
                                <onleft>17</onleft>
                                <onright condition="!String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)">3</onright>
                                <onright condition="String.IsEqual(Window.Property(SkinVariables.SkinSettings.Category),thanks)">-192</onright>
                            </include>
                        </include>
                    </control>
                </include>
                <control type="group">
                    <visible>!Control.HasFocus(23)</visible>
                    <include content="Settings_InfoText">
                        <param name="id">6</param>
                    </include>
                </control>
                <control type="group">
                    <visible>Control.HasFocus(23)</visible>
                    <include content="Dialog_InfoText">
                        <param name="label">$LOCALIZE[31762]</param>
                        <param name="fallback">$INFO[System.BuildVersion,Kodi ,]$INFO[System.AddonVersion(skin.arctic.fuse.mod), • AFMod v,]</param>
                        <param name="colordiffuse">main_fg_50</param>
                        <param name="centerbottom">100</param>
                        <param name="left">440</param>
                        <param name="right">40</param>
                    </include>
                </control>
            </include>
        </include>

        <include content="Settings_Button">
            <param name="id">10</param>
            <param name="control">togglebutton</param>
            <!-- The script sets usealttexture on the selected category. Mimic Kodi's hardcoded 50% alpha on the selected SettingsCategory button -->
            <include>Texture_MainMenu_Highlight_ToggleButton_FakeFocus</include>
            <!-- The script replaces $SUBSTITUTE[label] with each category's own label -->
            <altlabel>[COLOR=$VAR[ColorSelected]]$SUBSTITUTE[label][/COLOR]</altlabel>
            <width>settings_category_w</width>
            <description>Category Button</description>
            <!-- The last category changes Skin Settings Level -->
            <onclick condition="String.IsEqual(System.CurrentControlId,-192)">Skin.SetString(Skin.SettingsLevel,$VAR[Value_SkinSettings_NextLevel])</onclick>
        </include>

        <include content="Settings_Label">
            <param name="id">14</param>
            <description>Group Label</description>
        </include>

        <include content="Settings_Button">
            <param name="id">7</param>
            <param name="control">button</param>
            <description>Setting Button</description>
            <textwidth>680</textwidth>
        </include>

        <include content="Settings_Button">
            <param name="id">8</param>
            <param name="control">radiobutton</param>
            <description>Setting Radiobutton</description>
        </include>

        <!-- Hidden lists to check active ratings -->
        <include content="Object_Hidden_List">
            <param name="id">1001</param>
            <content>plugin://script.skinvariables/?info=get_shortcuts_node&amp;skin=$VAR[Path_SkinVariables_SkinFolder]$INFO[Window(Home).Property(SkinVariables.ShortcutsNode.Reload),&amp;reload=,]&amp;menu=ratingsmovies</content>
        </include>
        <include content="Object_Hidden_List">
            <param name="id">1002</param>
            <content>plugin://script.skinvariables/?info=get_shortcuts_node&amp;skin=$VAR[Path_SkinVariables_SkinFolder]$INFO[Window(Home).Property(SkinVariables.ShortcutsNode.Reload),&amp;reload=,]&amp;menu=ratingstvshows</content>
        </include>

    </controls>

</window>
