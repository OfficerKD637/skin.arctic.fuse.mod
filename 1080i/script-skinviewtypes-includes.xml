<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- Defer shortcut generation until viewtypes have been rebuilt and the skin reloaded. -->
    <expression name="Exp_ViewTypes_RebuildPending">true</expression>
     
    <include name="Generator_BuildViewTypes_Onload">
        <param name="condition">true</param>
        <param name="params" />
        <definition>
            <onload condition="$PARAM[condition]">RunScript(script.skinvariables,action=buildviews$PARAM[params])</onload>
        </definition>
    </include>

</includes>