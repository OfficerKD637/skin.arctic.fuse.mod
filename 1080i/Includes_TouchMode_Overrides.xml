<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- Basic View Constants -->
    <constant name="view_side">200</constant>
    <constant name="view_offx">40</constant>
    <constant name="-view_offx">-40</constant>

    <!-- ============= -->
    <!-- Movement Defs -->
    <!-- ============= -->
    <!-- 7 Item: Icon -->
    <include name="List_Icon_Row_Movement">
        <left>view_touchmode_edge_l</left>
        <right>view_touchmode_edge_r</right>
        <preloaditems>0</preloaditems>
        <include content="Object_Movement" condition="$EXP[Exp_HomeMenu_IsStatic_Movement]">
            <param name="movement">view_icon_movement_downsize</param>
        </include>
        <movement>view_icon_movement</movement>
    </include>
