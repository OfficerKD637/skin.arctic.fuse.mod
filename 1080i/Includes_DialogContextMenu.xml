<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <variable name="Dialog_ContextMenu_SideButtons_WikiTitle">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.base_tvshowtitle))">$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.base_tvshowtitle)]</value>
        <value condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.base_title))">$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.base_title)]</value>
        <value condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.base_label))">$ESCINFO[Window(Home).Property(TMDbHelper.ListItem.base_label)]</value>
    </variable>

    <variable name="Dialog_ContextMenu_SideButtons_WikiType">
        <value condition="String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.base_dbtype),tvshow) | String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.base_dbtype),season) | String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.base_dbtype),episode)"> tv series</value>
        <value condition="String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.base_dbtype),movie)"> film</value>
    </variable>

    <variable name="DialogContextMenu_HeaderLabel">
        <value condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.base_label)) + $EXP[Exp_AllowExpandedContextMenu]">$INFO[Window(Home).Property(TMDbHelper.ListItem.base_label)]</value>
        <value>$LOCALIZE[10106]</value>
    </variable>

    <expression name="DialogContextMenu_HasArtwork">[!String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.base_poster)) + $EXP[Exp_AllowExpandedContextMenu] + !Skin.HasSetting(ContextMenu.DisableArtwork)]</expression>

    <expression name="DialogContextMenu_Rows_7">[Integer.IsEqual(Container(996).NumItems,7) + Integer.IsLessOrEqual(Container(6000).NumItems,5)]</expression>
    <expression name="DialogContextMenu_Rows_6">[[Integer.IsEqual(Container(996).NumItems,6) + Integer.IsLessOrEqual(Container(6000).NumItems,5)] | [Integer.IsLess(Container(996).NumItems,6) + Integer.IsEqual(Container(6000).NumItems,5)]]</expression>
    <expression name="DialogContextMenu_Rows_5">[[Integer.IsEqual(Container(996).NumItems,5) + Integer.IsLessOrEqual(Container(6000).NumItems,4)] | [Integer.IsLess(Container(996).NumItems,5) + Integer.IsEqual(Container(6000).NumItems,4)]]</expression>
    <expression name="DialogContextMenu_Rows_4">[[Integer.IsEqual(Container(996).NumItems,4) + Integer.IsLessOrEqual(Container(6000).NumItems,3)] | [Integer.IsLess(Container(996).NumItems,4) + Integer.IsEqual(Container(6000).NumItems,3)]]</expression>
    <expression name="DialogContextMenu_Rows_3">[[Integer.IsEqual(Container(996).NumItems,3) + Integer.IsLessOrEqual(Container(6000).NumItems,2)] | [Integer.IsLess(Container(996).NumItems,3) + Integer.IsEqual(Container(6000).NumItems,2)]]</expression>
    <expression name="DialogContextMenu_Rows_2">[Integer.IsEqual(Container(996).NumItems,2) + Integer.IsLessOrEqual(Container(6000).NumItems,1)]</expression>
    <expression name="DialogContextMenu_Rows_1">[Integer.IsEqual(Container(996).NumItems,1) + Integer.IsLessOrEqual(Container(6000).NumItems,1)]</expression>
    <expression name="DialogContextMenu_Rows_all">![$EXP[DialogContextMenu_Rows_7] | $EXP[DialogContextMenu_Rows_6] | $EXP[DialogContextMenu_Rows_5] | $EXP[DialogContextMenu_Rows_4] | $EXP[DialogContextMenu_Rows_3] | $EXP[DialogContextMenu_Rows_2] | $EXP[DialogContextMenu_Rows_1]]</expression>

    <constant name="constant_contextmenu_pad_all">0</constant>
    <constant name="constant_contextmenu_pad_7">40</constant>
    <constant name="constant_contextmenu_pad_6">80</constant>
    <constant name="constant_contextmenu_pad_5">120</constant>
    <constant name="constant_contextmenu_pad_4">160</constant>
    <constant name="constant_contextmenu_pad_3">200</constant>
    <constant name="constant_contextmenu_pad_2">240</constant>
    <constant name="constant_contextmenu_pad_1">280</constant>

     <include name="DialogContextMenu_Backing_Panel">
        <definition>
            <control type="group">
                <visible>$EXP[DialogContextMenu_Rows_$PARAM[count]]</visible>
                <top>constant_contextmenu_pad_$PARAM[count]</top>
                <bottom>constant_contextmenu_pad_$PARAM[count]</bottom>
                <include content="Dialog_Background_Panel">
                    <param name="dialog_size">$PARAM[dialog_size]</param>
                </include>
                <include content="Object_Control" condition="$PARAM[has_menu]">
                    <param name="control">group</param>
                    <include>Size_Dialog_Pad</include>
                    <control type="group">
                        <include>Size_Group_Body</include>
                        <control type="group">
                            <include content="Object_CenterLeft" condition="!$PARAM[flip]">
                                <param name="centerleft">60</param>
                            </include>
                            <include content="Object_Right" condition="$PARAM[flip]">
                                <param name="right">120</param>
                            </include>
                            <include>Dialog_Line_Vert</include>
                        </control>
                    </control>
                </include>
            </control>
        </definition>
    </include>

    <include name="DialogContextMenu_Backing">
        <definition>
            <include>$PARAM[dialog_size]</include>
            <include>Animation_BounceIn_Dialog</include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">all</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">7</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">6</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">5</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">4</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">3</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">2</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
            <include content="DialogContextMenu_Backing_Panel">
                <param name="count">1</param>
                <param name="dialog_size">$PARAM[dialog_size]</param>
                <param name="has_menu">$PARAM[has_menu]</param>
                <param name="flip">$PARAM[flip]</param>
            </include>
        </definition>
    </include>

    <include name="DialogContextMenu_Slide">
        <animation effect="slide" start="0" end="0,40" condition="$EXP[DialogContextMenu_Rows_7]">Conditional</animation>
        <animation effect="slide" start="0" end="0,80" condition="$EXP[DialogContextMenu_Rows_6]">Conditional</animation>
        <animation effect="slide" start="0" end="0,120" condition="$EXP[DialogContextMenu_Rows_5]">Conditional</animation>
        <animation effect="slide" start="0" end="0,160" condition="$EXP[DialogContextMenu_Rows_4]">Conditional</animation>
        <animation effect="slide" start="0" end="0,200" condition="$EXP[DialogContextMenu_Rows_3]">Conditional</animation>
        <animation effect="slide" start="0" end="0,240" condition="$EXP[DialogContextMenu_Rows_2]">Conditional</animation>
        <animation effect="slide" start="0" end="0,280" condition="$EXP[DialogContextMenu_Rows_1]">Conditional</animation>
    </include>

    <include name="Dialog_ContextMenu">
        <param name="has_artwork">$EXP[DialogContextMenu_HasArtwork]</param>
        <param name="has_template">true</param>
        <param name="has_menu">[!Skin.HasSetting(ContextMenu.DisableOptionsTray) + $EXP[Exp_AllowExpandedContextMenu]]</param>
        <param name="include_tray">ButtonMenu_ContextControls</param>
        <param name="hidden_icon">true</param>
        <param name="scrollbar_id">61</param>
        <param name="visible">true</param>
        <param name="flip">Skin.HasSetting(ContextMenu.FlipMenu)</param>
        <definition>
            <include>Defs_Background_Loader</include>
            <include>Dialog_Dim_Overlay</include>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <include content="Dialog_Backing" condition="$PARAM[has_artwork]">
                    <param name="dialog_size">Dimension_DialogFlipMenu</param>
                </include>
                <include content="DialogContextMenu_Backing" condition="!$PARAM[has_artwork]">
                    <param name="dialog_size">Dimension_DialogMiniMenu</param>
                    <param name="has_menu">$PARAM[has_menu]</param>
                    <param name="flip">$PARAM[flip]</param>
                </include>

                <!-- Content -->
                <control type="group" id="8000">
                    <include>Size_Dialog_Pad</include>
                    <include condition="!$PARAM[has_artwork]">DialogContextMenu_Slide</include>

                    <!-- Right -->
                    <control type="group">
                        <include condition="!$PARAM[flip] + $PARAM[has_artwork]">Dialog_Panel</include>
                        <include condition="!$PARAM[flip] + $PARAM[has_artwork]">Size_RightGroup_Large</include>
                        <include condition="$PARAM[flip] + $PARAM[has_artwork]">Size_LeftGroup_Large</include>
                        <include content="DialogPlot_Artwork" condition="$PARAM[has_artwork]">
                            <param name="poster_icon">$INFO[Window(Home).Property(TMDbHelper.ListItem.base_poster)]</param>
                            <param name="hidden_icon">$PARAM[hidden_icon]</param>
                        </include>
                    </control>

                    <!-- Left -->
                    <control type="group">
                        <include condition="!$PARAM[flip] + $PARAM[has_artwork]">Size_LeftGroup_Large</include>
                        <include condition="$PARAM[flip] + $PARAM[has_artwork]">Size_RightGroup_Large</include>
                        <include condition="$PARAM[flip] + $PARAM[has_artwork]">Dialog_Panel</include>
                        <control type="group">
                            <include>Size_Group_Head</include>
                            <include content="Dialog_Head" condition="!$PARAM[flip] + $PARAM[has_menu]">
                                <param name="label">$VAR[DialogContextMenu_HeaderLabel]</param>
                                <param name="left">constant_dialog_header_right</param>
                                <param name="right">constant_dialog_pad</param>
                            </include>
                            <include content="Dialog_Head" condition="![!$PARAM[flip] + $PARAM[has_menu]]">
                                <param name="label">$VAR[DialogContextMenu_HeaderLabel]</param>
                            </include>
                            <include content="Dialog_Head_CloseButton">
                                <param name="flipped">!$PARAM[flip] + $PARAM[has_menu]</param>
                            </include>
                        </control>

                        <control type="group">
                            <include>Size_Group_Body</include>

                            <!-- Plot Buttons -->
                            <include content="Object_Control" condition="$PARAM[has_menu]">
                                <param name="control">group</param>
                                <control type="list" id="6000">
                                    <top>20</top>
                                    <include content="Object_CenterLeft" condition="!$PARAM[flip]">
                                        <param name="centerleft">70</param>
                                    </include>
                                    <include content="Object_CenterRight" condition="$PARAM[flip]">
                                        <param name="centerright">50</param>
                                    </include>
                                    <orientation>vertical</orientation>
                                    <height>700</height>
                                    <width>100</width>
                                    <onright condition="!$PARAM[flip]">996</onright>
                                    <onleft condition="$PARAM[flip]">$PARAM[scrollbar_id]</onleft>
                                    <include content="ButtonMenu_Tray_Layout">
                                        <param name="id">6000</param>
                                        <param name="slide">false</param>
                                    </include>
                                    <content>
                                        <include>$PARAM[include_tray]</include>
                                    </content>
                                </control>
                                <include content="Object_Control" condition="$PARAM[has_artwork]">
                                    <param name="control">group</param>
                                    <include content="Object_CenterLeft" condition="!$PARAM[flip]">
                                        <param name="centerleft">60</param>
                                    </include>
                                    <include content="Object_Right" condition="$PARAM[flip]">
                                        <param name="right">120</param>
                                    </include>
                                    <include>Dialog_Line_Vert</include>
                                </include>
                            </include>
                            <control type="group">
                                <control type="group">
                                    <top>-120</top>
                                    <height>40</height>
                                    <include content="Dialog_ItemPage" condition="!$PARAM[flip] + $PARAM[has_menu]">
                                        <param name="align">right</param>
                                        <param name="flipped">true</param>
                                        <param name="id">996</param>
                                    </include>
                                    <include content="Dialog_ItemPage" condition="![!$PARAM[flip] + $PARAM[has_menu]]">
                                        <param name="id">996</param>
                                    </include>
                                </control>
                                <control type="grouplist" id="996">
                                    <pagecontrol>$PARAM[scrollbar_id]</pagecontrol>
                                    <onright>$PARAM[scrollbar_id]</onright>
                                    <onleft condition="!$PARAM[flip]">6000</onleft>
                                    <include content="Object_Left" condition="!$PARAM[flip] + $PARAM[has_menu]">
                                       <param name="left">140</param>
                                    </include>
                                    <include>Size_Grouplist_Pad</include>
                                </control>
                            </control>
                            <control type="group">
                                <include content="Dialog_Scrollbar">
                                    <param name="id">$PARAM[scrollbar_id]</param>
                                    <include content="Object_CenterRight" condition="!$PARAM[flip]">
                                        <param name="centerright">0</param>
                                    </include>
                                    <include content="Object_CenterRight" condition="$PARAM[flip] + $PARAM[has_menu]">
                                        <param name="centerright">120</param>
                                    </include>
                                    <onleft>996</onleft>
                                    <onright condition="$PARAM[flip]">6000</onright>
                                    <top>20</top>
                                </include>
                            </control>
                        </control>
                    </control>

                </control>
            </control>
            <include content="Settings_Button" condition="$PARAM[has_template]">
                <param name="id">1000</param>
                <param name="control">button</param>
                <param name="dialog">true</param>
                <include content="Object_Width" condition="$PARAM[has_menu]">
                    <param name="width">400</param>
                </include>
                <width>dialog_main_button_w</width>
            </include>
        </definition>
    </include>

</includes>
