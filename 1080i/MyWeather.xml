<?xml version="1.0" encoding="UTF-8"?>
<window id="2600">
    <defaultcontrol always="true">8000</defaultcontrol>
    <menucontrol>9000</menucontrol>
    <onload>ClearProperty(Weather.Trend.Page,weather)</onload>
    <controls>

        <include content="Object_Hidden_Button">
            <param name="id">8000</param>
            <onclick>Weather.LocationNext</onclick>
            <onleft condition="$EXP[Exp_Weather_Trend_Prev_Radar]">SetProperty(Weather.Trend.Page,Radar,weather)</onleft>
            <onleft condition="$EXP[Exp_Weather_Trend_Prev_UV]">SetProperty(Weather.Trend.Page,UV,weather)</onleft>
            <onleft condition="$EXP[Exp_Weather_Trend_Prev_Details]">SetProperty(Weather.Trend.Page,Details,weather)</onleft>
            <onleft condition="$EXP[Exp_Weather_Trend_Prev_Temperature]">ClearProperty(Weather.Trend.Page,weather)</onleft>
            <onright condition="$EXP[Exp_Weather_Trend_Next_Details]">SetProperty(Weather.Trend.Page,Details,weather)</onright>
            <onright condition="$EXP[Exp_Weather_Trend_Next_UV]">SetProperty(Weather.Trend.Page,UV,weather)</onright>
            <onright condition="$EXP[Exp_Weather_Trend_Next_Radar]">SetProperty(Weather.Trend.Page,Radar,weather)</onright>
            <onright condition="$EXP[Exp_Weather_Trend_Next_Temperature]">ClearProperty(Weather.Trend.Page,weather)</onright>
            <include>Action_View_SlideOver_OnFocus</include>
        </include>

        <include>Background_StartUp_Layered</include>
        <include>Weather_Trend_Shading</include>
        <include>Weather_Trend_Source</include>
        <include condition="$EXP[Exp_HomeMenu_IsTopBar]">Hub_Top_Bezier</include>
        <include condition="!$EXP[Exp_HomeMenu_IsTopBar]">Hub_Left_Bezier</include>

        <control type="group">
            <include>Animation_View_WindowChange</include>
            <include>Animation_View_SlideOver</include>
            <control type="group">
                <include content="Object_Left" condition="[Skin.String(Home.SideMenuCollapse,Never) | Skin.HasSetting(Views.DisableItemPeek)]">
                    <param name="left">120</param>
                </include>
                <control type="group">
                    <visible>!$EXP[Exp_Weather_Is_Loading]</visible>
                    <include>Weather_Trend_Today</include>
                    <include>Weather_Trend_Forecast</include>
                    <include>Weather_Trend_UV_Forecast</include>
                    <include>Weather_Trend_Radar_Page</include>
                </control>
                <include>Weather_Trend_Header</include>
            </control>


            <control type="group">
                <include content="Object_Left" condition="[Skin.String(Home.SideMenuCollapse,Never) | Skin.HasSetting(Views.DisableItemPeek)]">
                    <param name="left">120</param>
                </include>
                <visible>!$EXP[Exp_Weather_Is_Loading]</visible>
                <include>Weather_Trend_Page_Hint</include>
            </control>
            <control type="group">
                <visible>!$EXP[Exp_Weather_Is_Loading]</visible>
                <include>Furniture_Bottom_Right</include>
                <include condition="Skin.HasSetting(Furniture.EnableLeftHeader)">Furniture_Top</include>
                <control type="group">
                    <include content="Animation_View_SlideOver_Invert">
                        <param name="time">400</param>
                    </include>
                    <include condition="!Skin.HasSetting(Furniture.EnableLeftHeader)">Furniture_DateLabel_TopRight</include>
                </control>
            </control>
        </control>        

        <include>Home_Menu_Media</include>

        <include content="Furniture_Busy">
            <param name="hasspinner">true</param>
            <param name="spinspinner">true</param>
            <param name="icon">special://skin/extras/icons/kodi.png</param>
            <param name="hasbackground">Skin.HasSetting(ToastNotifications.Tabbed)</param>
            <param name="haslabel">Skin.HasSetting(ToastNotifications.Tabbed)</param>
            <param name="spinnervisible">[!Window.IsActive(DialogVolumeBar.xml) | Player.Muted]</param>
            <param name="visible">$EXP[Exp_Weather_Is_Loading]</param>
            <param name="visible_condition">false</param>
            <param name="windowopen_condition">false</param>
        </include>

    </controls>

</window>
