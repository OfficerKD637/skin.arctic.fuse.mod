    <!-- Horizontal Layout (Classic) -->
    <include name="View_Combined_Wall_Horz">
        <param name="right_padding">180</param>
        <param name="top">306</param>
        <param name="top_horz">250</param>
        <param name="offset_x">view_offx</param>
        <param name="offset_y">20</param>
        <param name="bottom_padding">-40</param>
        <definition>
            <control type="group">
                <visible>Control.IsVisible(55$PARAM[id])</visible>
                <control type="group">
                    <include>Widget_List_Visibility</include>
                    <include content="$PARAM[include]" condition="$EXP[Exp_View_WallVert]">
                        <param name="id">56$PARAM[id]</param>
                        <param name="icon">$PARAM[icon]</param>
                        <param name="control">panel</param>
                        <param name="orientation">vertical</param>
                        <param name="offset_x">$PARAM[offset_x]</param>
                        <param name="offset_y">$PARAM[offset_y]</param>
                        <preloaditems>0</preloaditems>
                        <top>$PARAM[top]</top>
                        <bottom>$PARAM[bottom_padding]</bottom>
                        <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                            <param name="right">$PARAM[right_padding]</param>
                        </include>
                        <onleft condition="Skin.String(Home.SideMenuCollapse,Never)">SetProperty(List.ViewContainer,50)</onleft>
                        <onleft condition="Skin.String(Home.SideMenuCollapse,Never)">SetFocus(303,1,absolute)</onleft>
                        <onright condition="$EXP[Exp_IsAlphabetStrip] + !Integer.IsEqual(Container(56$PARAM[id]).NumPages,1)">SetFocus(616,$VAR[Action_Letter_Position],absolute)</onright>
                        <onright condition="![$EXP[Exp_IsAlphabetStrip] + !Integer.IsEqual(Container(56$PARAM[id]).NumPages,1)]">611</onright>

                        <pagecontrol>66</pagecontrol>
                        <visible>$PARAM[visible]</visible>

                        <onup>SetFocus(56$PARAM[id],0,absolute)</onup>
                        <onup>55$PARAM[id]</onup>
                        <ondown>SetFocus(56$PARAM[id],0,absolute)</ondown>
                        <ondown>55$PARAM[id]</ondown>
                        <onback>SetFocus(56$PARAM[id],0,absolute)</onback>
                        <onback>55$PARAM[id]</onback>

                        <animation type="Conditional" reversible="false" condition="Container(56$PARAM[id]).IsUpdating">
                            <effect type="fade" start="100" end="0" time="200" delay="600" />
                        </animation>

                        <visible>Container(55$PARAM[id]).ListItem.IsFolder</visible>
                        <onclick condition="Container(56$PARAM[id]).ListItem.IsFolder">Container.Update($INFO[Container(56$PARAM[id]).ListItem.FolderPath])</onclick>
                        <onclick condition="Container(56$PARAM[id]).ListItem.IsFolder">SetFocus(50)</onclick>
                        <onclick condition="!Container(56$PARAM[id]).ListItem.IsFolder">PlayMedia($ESCINFO[Container(56$PARAM[id]).ListItem.FileNameAndPath])</onclick>
                        <content target="$VAR[Path_CollectionNode_Target]">$VAR[View_56$PARAM[id]_Content]</content>
                        <onfocus>SetProperty(TMDbHelper.WidgetContainer,56$PARAM[id])</onfocus>
                        <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                        <include>Action_View_SlideOver_OnFocus</include>
                    </include>

                    <include content="$PARAM[include]" condition="!$EXP[Exp_View_WallVert]">
                        <param name="id">56$PARAM[id]</param>
                        <param name="icon">$PARAM[icon]</param>
                        <param name="control">panel</param>
                        <param name="offset_x">$PARAM[offset_x]</param>
                        <preloaditems>0</preloaditems>
                        <top>$PARAM[top_horz]</top>
                        <bottom>$PARAM[bottom_padding]</bottom>
                        <include content="Object_Right" condition="Skin.String(Home.SideMenuCollapse,Never)">
                            <param name="right">$PARAM[right_padding]</param>
                        </include>

                        <include content="Action_View_Movement_OnDown">
                            <param name="container">Container(56$PARAM[id]).</param>
                            <param name="filter_edit">false</param>
                        </include>

                        <pagecontrol>60</pagecontrol>
                        <visible>$PARAM[visible]</visible>

                        <onup>SetFocus(56$PARAM[id],0,absolute)</onup>
                        <onup>55$PARAM[id]</onup>
                        <onback>SetFocus(56$PARAM[id],0,absolute)</onback>
                        <onback>55$PARAM[id]</onback>

                        <animation type="Conditional" reversible="false" condition="Container(56$PARAM[id]).IsUpdating">
                            <effect type="fade" start="100" end="0" time="200" delay="600" />
                        </animation>

                        <visible>Container(55$PARAM[id]).ListItem.IsFolder</visible>
                        <onclick condition="Container(56$PARAM[id]).ListItem.IsFolder">Container.Update($INFO[Container(56$PARAM[id]).ListItem.FolderPath])</onclick>
                        <onclick condition="Container(56$PARAM[id]).ListItem.IsFolder">SetFocus(50)</onclick>
                        <onclick condition="!Container(56$PARAM[id]).ListItem.IsFolder">PlayMedia($ESCINFO[Container(56$PARAM[id]).ListItem.FileNameAndPath])</onclick>
                        <content target="$VAR[Path_CollectionNode_Target]">$VAR[View_56$PARAM[id]_Content]</content>
                        <onfocus>SetProperty(TMDbHelper.WidgetContainer,56$PARAM[id])</onfocus>
                        <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                        <include>Action_View_SlideOver_OnFocus</include>
                    </include>

                    <include content="Widget_Busy">
                        <param name="label">$INFO[Container(55$PARAM[id]).ListItem.Label]</param>
                        <param name="visible">Container(56$PARAM[id]).IsUpdating</param>
                        <param name="include">$PARAM[include]</param>
                        <top>246</top>
                        <left>view_side</left>
                    </include>
                    <include content="Widget_Busy">
                        <param name="label">$INFO[Container(55$PARAM[id]).ListItem.Label]</param>
                        <param name="visible">Container(56$PARAM[id]).IsUpdating</param>
                        <param name="include">$PARAM[include]</param>
                        <param name="first_row_special">false</param>
                        <top>596</top>
                        <left>view_side</left>
                        <animation effect="slide" end="0,-16" condition="Skin.String(Home.SideMenuCollapse,Never)">Conditional</animation>
                    </include>
                </control>
                <control type="group">
                    <control type="image">
                        <bottom>0</bottom>
                        <height>480</height>
                        <texture colordiffuse="main_bg_90">common/gradient-v.png</texture>
                        <animation effect="fade" start="0" end="100" time="300" tween="sine" easing="in" condition="[$EXP[Exp_View_SortModeButtons_HasFocus] | $EXP[Exp_View_ScrollFilter_HasFocus] | $EXP[Exp_View_AlphabetFilter_HasFocus] | Window.IsVisible(1171)]" reversible="false">Conditional</animation>
                        <animation effect="fade" start="100" end="0" time="300" tween="sine" easing="in" condition="![$EXP[Exp_View_SortModeButtons_HasFocus] | $EXP[Exp_View_ScrollFilter_HasFocus] | $EXP[Exp_View_AlphabetFilter_HasFocus] | Window.IsVisible(1171)]" reversible="false">Conditional</animation>
                    </control>
                </control>
            </control>
        </definition>
    </include>

