<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1134">
    <defaultcontrol always="true">61</defaultcontrol>
    <onload>SetProperty(TMDbHelper.ContextMenu,True)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(TMDBHelper.ListItem.Monitor.TMDb_ID)) | !String.IsEqual(Window(Home).Property(TMDBHelper.ListItem.Monitor.TMDb_Type),tv)">Dialog.Close(1134,true)</onload>
    <controls>

        <include content="Dialog_PictureInfo">
            <param name="dialog_size">Dimension_DialogMainMenu</param>
            <param name="dialog_right">1280</param>
            <param name="include_items">Items_Dialog_PictureInfo_TVShowRatings</param>
            <param name="icon">$INFO[Window(1133).Property(icon)]</param>
            <param name="header">$INFO[Window(1133).Property(header)]</param>
            <param name="itemline">$INFO[Window(1133).Property(itemline)]</param>
            <param name="include_itemline">!String.IsEmpty(Window(1133).Property(itemline))</param>
            <param name="include_codecs">Skin.String(InfoDialog.NavigationStyle,Wall) | [!Skin.String(InfoDialog.NavigationStyle,Wall) + String.IsEmpty(Skin.String(Furniture.BottomLeft.Enable))]</param>
            <param name="codecs">Info_Media</param>
        </include>

        <include content="Furniture_Busy">
            <param name="hasspinner">true</param>
            <param name="spinspinner">true</param>
            <param name="icon">special://skin/extras/icons/kodi.png</param>
            <param name="spinnervisible">[!Window.IsActive(DialogVolumeBar.xml) | Player.Muted]</param>
            <param name="haslabel">false</param>
            <param name="visible_delay">800</param>
            <param name="windowopen_delay">800</param>
            <param name="visible">[Integer.IsEqual(Container(8001).NumItems,0) | Container(8001).IsUpdating]</param>
        </include>
    </controls>
</window>