#: /1080i/Includes_Shortcuts_Window.xml
msgctxt "#31632"
msgid "[B]Tiles[/B] are small cards that display information at the top of the menu. You can configure the number of tiles and their content."
msgstr "[B]Blocos[/B] são pequenos cartões que exibem informações no topo do menu. Você pode configurar o número de blocos e seu conteúdo."

#: /1080i/Includes_Shortcuts_Window.xml
msgctxt "#31633"
msgid "Customise the content of [B]Tile "
msgstr "Personalize o conteúdo de [B]Bloco "

#: /1080i/Includes_Shortcuts_Window.xml
msgctxt "#31634"
msgid "[B]Shortcuts[/B] are the primary menu options displayed below the tiles."
msgstr "[B]Atalhos[/B] são as principais opções de menu exibidas abaixo dos blocos."

#: /1080i/Includes_Shortcuts_Window.xml
msgctxt "#31635"
msgid "The [B]Options tray[/B] is a row of customizable quick access buttons at the bottom of the menu."
msgstr "A [B]Opções de Bandeja[/B] é uma linha de botões de acesso rápido personalizáveis na parte inferior do menu."

#: /1080i/Includes_Views_Combined_Wall.xml
msgctxt "#31636"
msgid "Combined Quad Wall"
