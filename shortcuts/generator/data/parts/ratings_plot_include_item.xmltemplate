<include content="Info_Line_Ratings_Plot_Item">
    <param name="path">{item_path}</param>
    <param name="visible">[Integer.IsGreater($PARAM[source]($PARAM[source_prefix]{item_path}),0) | !String.IsEmpty($PARAM[source]($PARAM[source_prefix]{item_image}))] + $PARAM[visible_mod]Control.IsVisible($PARAM[list]$MATH[{item_x} + 1]8)</param>
    <param name="info">$PARAM[source]($PARAM[source_prefix]{item_path})</param>
    <param name="service">$PARAM[service]</param>
    <param name="source">$PARAM[source]</param>
    <param name="source_prefix">$PARAM[source_prefix]</param>
    <param name="colordiffuse">$PARAM[colordiffuse]</param>
</include>
