<include content="Info_Line_Ratings_Plot_Counts">
    <param name="previous">$PARAM[list]{item_x}</param>
    <param name="next">$PARAM[list]$MATH[{item_x} + 1]</param>
    <param name="available">Integer.IsGreater($PARAM[source]($PARAM[source_prefix]{item_path}),0) | !String.IsEmpty($PARAM[source]($PARAM[source_prefix]{item_image}))</param>
</include>
