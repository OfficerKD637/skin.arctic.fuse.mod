<include content="Hub_Widget_Wall">
    <param name="id">{widget_id}</param>
    <param name="window_id">{window_id}</param>
    <param name="menuid">{grouplist_endrow_selector_id}</param>
    <param name="backid">{grouplist_endrow_selector_id}</param>
    <param name="content">{widget_path}</param>
    <param name="include">{widget_include}</param>
    <param name="target">{widget_target}</param>
    <param name="sortby">{widget_sortby}</param>
    <param name="sortorder">{widget_sortorder}</param>
    <param name="limit">{widget_limit}</param>
    <param name="visible">[{widget_category_visible}] + String.IsEqual(Container({grouplist_endrow_selector_id}).ListItem.Property(guid),{item_guid}) + String.IsEmpty(Window.Property(Widgets.ResetPosition))</param>
    <param name="shortstack_enabled">{widget_shortstack}</param>
    <param name="shortstack_id">{widget_shortstack_id}</param>
    <param name="shortstack_visible">{widget_shortstack_visible}</param>
    <param name="wall_textlabels_offset">{widget_wall_textlabels_offset}</param>
    <param name="custom_content">{widget_custom_content}</param>
</include>