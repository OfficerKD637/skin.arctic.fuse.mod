<contents>
    <value name="comments">Static Power Main Menu</value>
    <template>generator/data/parts/basic_include.xmltemplate</template>
    <value name="includes_name">skinvariables-powermainmenu-staticitems</value>
    <value name="includes_part">
        <items menu="powermainmenu">
            <item>
                <template>generator/data/parts/menu_item.xmltemplate</template>
                <datafile>generator/data/setup/onclick_path.xml</datafile>
                <datafile>generator/data/setup/powermainmenu_item.xml</datafile>
                <condition>{item_disabled}!=True</condition>
                <condition>{item_label}!=</condition>
                <rules name="parts_additional">
                    <rule>
                        <condition>{item_path}&lt;&lt;ActivateWindow||{item_path}==Custom_Menu||{item_path_opendialog}!=</condition>
                        <value>&lt;onclick&gt;Dialog.Close(1170,true)&lt;/onclick&gt;</value>
                    </rule>
                    <rule>
                        <condition>True</condition>
                        <value>&lt;onclick&gt;Close&lt;/onclick&gt;</value>
                    </rule>
                </rules>
            </item>
        </items>
    </value>
</contents>